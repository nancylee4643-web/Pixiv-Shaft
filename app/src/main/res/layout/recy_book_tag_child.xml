<?xml version="1.0" encoding="utf-8"?>
<!--
  「按标签筛选」—— 父标签分组下的子标签行（缩进卡片）。与 recy_book_tag 同款样式，
  仅左侧缩进 20dp 表示从属；单击 = 按该子标签筛选（与普通标签行为一致）。
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:clickable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="?attr/colorPrimary"
        app:cardCornerRadius="@dimen/four_dp"
        app:cardElevation="2dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/star_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/sixteen_dp"
                android:layout_marginStart="@dimen/eight_dp"
                android:layout_toStartOf="@+id/illust_count"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/illust_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/sixteen_dp"
                android:textColor="@color/white" />

        </RelativeLayout>

    </androidx.cardview.widget.CardView>
</layout>
